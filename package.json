{
  "name": "whodoor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @whodoor/client build && pnpm --filter @whodoor/server build",
    "start": "node packages/server/dist/index.js",
    "typecheck": "pnpm -r typecheck",
    "bots": "pnpm --filter @whodoor/server bots",
    "test": "pnpm --filter @whodoor/shared test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}